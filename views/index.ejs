<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <title>Task Manager</title>
</head>

<body class="bg-zinc-950 font-sans antialiased text-zinc-100">
    <div class="main w-full min-h-screen bg-zinc-950 p-6 sm:p-10 flex flex-col items-center gap-8">

        <!-- Task Creation Form -->
        <div class="form w-full max-w-3xl bg-zinc-900 border border-zinc-800 rounded-2xl p-6 shadow-xl">
            <form action="/create" method="POST" class="flex flex-col gap-4">
                <input name="title"
                    class="w-full px-4 py-2.5 bg-zinc-800/80 border border-zinc-700/70 rounded-lg text-sm text-zinc-100 placeholder-zinc-500 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 transition duration-150"
                    type="text" placeholder="Enter your Title" name="title" required>
                <textarea name="details"
                    class="w-full px-4 py-2.5 bg-zinc-800/80 border border-zinc-700/70 rounded-lg text-sm text-zinc-100 placeholder-zinc-500 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 transition duration-150 resize-y min-h-24"
                    placeholder="Enter your Details" name="details" required></textarea>
                <input
                    class="self-start px-5 py-2.5 bg-blue-600 hover:bg-blue-500 active:bg-blue-700 text-white text-sm font-medium rounded-lg cursor-pointer transition duration-150 shadow-md shadow-blue-600/20"
                    type="submit" value="Create Task">
            </form>
        </div>

        <!-- Task Grid -->
        <div class="tasks w-full max-w-3xl grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
            <% if (files && files.length> 0) { %>
                <% files.forEach(function(val) { %>
                    <div
                        class="task bg-zinc-900 border border-zinc-800 hover:border-zinc-700/80 rounded-xl p-5 flex flex-col justify-between gap-4 transition duration-150 shadow-sm">
                        <div>
                            <h2 class="text-base font-semibold text-white tracking-tight break-words line-clamp-2">
                                <%= val %>
                            </h2>
                        </div>
                        <div>
                            <a href="/file/<%= encodeURIComponent(val) %>"
                                class="text-xs font-medium text-blue-400 hover:text-blue-300 transition duration-150 hover:underline">Read
                                more </a>
                            <a href="/edit/<%=val%>"
                                class="text-xs font-medium text-green-400 hover:text-green-300 transition duration-150 hover:underline ml-4">Edit File Name</a>
                        </div>

                    </div>
                    <% }) %>
                        <% } else { %>
                            <!-- Empty State -->
                            <div
                                class="col-span-full py-12 px-4 border border-dashed border-zinc-800 rounded-2xl flex flex-col items-center justify-center text-center">
                                <p class="text-sm font-medium text-zinc-400">No tasks yet</p>
                                <p class="text-xs text-zinc-600 mt-1">Use the form above to create your first task.</p>
                            </div>
                            <% } %>
        </div>

    </div>
</body>

</html>